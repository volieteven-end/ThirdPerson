diff --git a/Source/ThirdPerson/Animation/CombatActionRules.h b/Source/ThirdPerson/Animation/CombatActionRules.h
index 23ca531..16d9bf7 100644
--- a/Source/ThirdPerson/Animation/CombatActionRules.h
+++ b/Source/ThirdPerson/Animation/CombatActionRules.h
@@ -8,6 +8,44 @@ inline bool LocksMovement(bool Dead, bool Hit, bool Guard, bool Attack, bool Dod
     return Dead || Hit || Guard || Attack || Dodge;
 }
 
+// Attacks lock WASD, but may be interrupted by a dodge. Hits/guard/death/dodges may not.
+inline bool BlocksDodge(bool Dead, bool Hit, bool Guard, bool Dodge)
+{
+    return Dead || Hit || Guard || Dodge;
+}
+
+// The window starts at the natural end of the FIRST dodge, not at input time.
+struct FDashComboWindow
+{
+    int NextIndex = -1;
+    bool bDashing = false;
+    bool bQueued = false;
+    double ExpiresAt = 0.0;
+    void Reset() { NextIndex = -1; bDashing = bQueued = false; ExpiresAt = 0.0; }
+    void Arm(int Index) { Reset(); NextIndex = Index; bDashing = true; }
+    bool IsOpen(double Now) const { return NextIndex >= 0 && (bDashing || Now <= ExpiresAt); }
+    bool Queue(double Now)
+    {
+        if (!bDashing || !IsOpen(Now)) { return false; }
+        bQueued = true;
+        return true;
+    }
+    void Finish(double Now, double Duration)
+    {
+        if (NextIndex < 0 || !bDashing) { return; }
+        if (Duration <= 0.0) { Reset(); return; }
+        bDashing = false;
+        ExpiresAt = Now + Duration;
+    }
+    int Consume(double Now)
+    {
+        if (bDashing) { return -1; }
+        const int Index = IsOpen(Now) ? NextIndex : -1;
+        Reset();
+        return Index;
+    }
+};
+
 // A single intent belongs to exactly one action generation. Early clicks are
 // retained until its chain point; interruption never carries them to a new action.
 struct FComboBuffer
diff --git a/Source/ThirdPerson/Character/TPCCharacter.cpp b/Source/ThirdPerson/Character/TPCCharacter.cpp
index a673fa6..7ce2360 100644
--- a/Source/ThirdPerson/Character/TPCCharacter.cpp
+++ b/Source/ThirdPerson/Character/TPCCharacter.cpp
@@ -438,7 +438,9 @@ void ATPCCharacter::HandleHealthChanged(float CurrentHealth,float MaxHealth)
 }
 void ATPCCharacter::Dash()
 {
-	if (IsMovementInputLocked())
+    // Attacks still lock WASD, but no longer lock the dedicated dash action.
+    if (TPCActionRules::BlocksDodge(bActionDead, bMovementLockedByHit,
+        CombatComponent && CombatComponent->IsBlocking(), IsDashing()))
 	{
 		return;
 	}
@@ -505,7 +507,12 @@ void ATPCCharacter::Dash()
 		UE_LOG(LogTemp, Warning, TEXT("Dash needs a root-motion montage in BP_TPCCharacter."));
 		return;
 	}
-	if (IsTurningInPlace()) { CancelMotionAction(); }
+    // A rejected dash (cooldown, stamina, missing montage/AnimInstance) must not cancel a valid attack.
+    if (!GetMesh() || !GetMesh()->GetAnimInstance()) { return; }
+    if (IsTurningInPlace()) { CancelMotionAction(); }
+    bAttackTargetAssistActive = false;
+    if (MotionWarpingComponent) { MotionWarpingComponent->RemoveWarpTarget(AttackWarpTargetName); }
+    if (CombatComponent) { CombatComponent->CancelAttackForDash(AttackDashCancelBlendOut); }
 	if (StartMotionMontage(SelectedDashMontage, ETPCMotionAction::Dodge))
 	{
 		if (!StaminaComponent->TryConsume(DashCost)) { CancelMotionAction(); return; }
@@ -648,15 +655,25 @@ void ATPCCharacter::StopBlock()
 
 void ATPCCharacter::HandlePrimaryAttack()
 {
-	if (!CombatComponent || !GetCharacterMovement() || bActionDead || bMovementLockedByHit || IsDashing()) { return; }
+	if (!CombatComponent || !GetCharacterMovement() || bActionDead || bMovementLockedByHit) { return; }
+    if (IsDashing())
+    {
+        CombatComponent->QueueAttackDuringDash();
+        return;
+    }
 	if (IsTurningInPlace()) { CancelMotionAction(); }
-	// Already attacking must route to the current combo BEFORE selecting by falling/crouch.
 	if (CombatComponent->IsMeleeAttackInProgress())
 	{
 		CombatComponent->TryAttack();
 		return;
